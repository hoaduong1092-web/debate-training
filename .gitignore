# ==========================================
# Root .gitignore for AI DEBATE MASTER
# ==========================================

# ── Dependencies ──────────────────────────
node_modules/
*/node_modules/
.pnp
.pnp.js

# ── Environment & Secrets ─────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ── Production Build Outputs ──────────────
dist/
*/dist/
build/
*/build/
.next/
out/

# ── TypeScript & Cache ────────────────────
*.tsbuildinfo
*/tsconfig.app.tsbuildinfo
*/tsconfig.node.tsbuildinfo
.cache/
*/.cache/
.parcel-cache/

# ── Python Runtime & Bytecode ─────────────
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# ── Logs & Debug ──────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Local Runtime & Uploads ───────────────
backend/uploads/audio/*
!backend/uploads/audio/.gitkeep
backend/.benchmark-text-debate-state.json
*.tmp
*.temp

# ── OS & IDE ──────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ── Archives ──────────────────────────────
*.zip

.vercel
.env*
