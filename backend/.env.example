# ==============================================================================
# AI DEBATE MASTER — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the backend server.
# NEVER commit the actual .env file with live secrets to Git.

# ── 1. Server & Runtime ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/debate_master?schema=public"
JWT_SECRET="replace-with-local-development-secret-key-32chars"
REDIS_URL="redis://localhost:6379"

# Enable demo guest fallback in development without requiring phone OTP login
ENABLE_DEMO=true

# ── 2. Primary AI Gateway (Google Gemini API / OpenAI Compatible) ─────────────
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

OPENAI_API_KEY=""
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# Model Routing & Mappings
AI_MODEL="gemini-3.6-flash"
MODEL_LOGIC_COACH="gemini-3.6-flash"
MODEL_OPPONENT="gemini-3.6-flash"
MODEL_ASSISTANT="gemini-3.6-flash"
MODEL_INTERACTION_COACH="gemini-3.6-flash"
MODEL_VOICE_COACH="gemini-3.6-flash"
MODEL_PSYCHOLOGY_COACH="gemini-3.6-flash"
MODEL_FALLBACK="gemini-3.5-flash"

# Optional: Beeknoee Gateway
# BEEKNOEE_API_KEY=""
# BEEKNOEE_BASE_URL="https://platform.beeknoee.com/api/v1"

# ── 4. Whisper Speech-To-Text Configuration ───────────────────────────────────
WHISPER_API_KEY=""
WHISPER_BASE_URL="https://api.groq.com/openai/v1"
WHISPER_MODEL="whisper-large-v3-turbo"

# ── 5. VoiceStudio Service (Python Local Bridge) ──────────────────────────────
VOICESTUDIO_URL="http://localhost:8000"

# ── 6. Payment Gateway: VNPay Sandbox ─────────────────────────────────────────
VNPAY_TMN_CODE="DEMO_TMN"
VNPAY_HASH_SECRET="DEMO_VNPAY_SECRET_KEY_512"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:5173/profile?payment=vnpay"
VNPAY_IPN_URL="http://localhost:3000/api/v1/payments/vnpay/ipn"

# ── 7. Payment Gateway: MoMo Sandbox ──────────────────────────────────────────
MOMO_PARTNER_CODE="MOMO_DEMO_PARTNER"
MOMO_ACCESS_KEY="MOMO_DEMO_ACCESS_KEY"
MOMO_SECRET_KEY="MOMO_DEMO_SECRET_KEY_256"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_REDIRECT_URL="http://localhost:5173/profile?payment=momo"
MOMO_IPN_URL="http://localhost:3000/api/v1/payments/momo/ipn"

# ── 8. Payment Gateway: SePAY (VietQR Bank Transfer) ──────────────────────────
SEPAY_API_KEY="SEPAY_DEMO_API_KEY"
SEPAY_ACCOUNT_NUMBER="0987654321"
SEPAY_BANK_NAME="MBBank"
SEPAY_ACCOUNT_NAME="AI DEBATE MASTER"
